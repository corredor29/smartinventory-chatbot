# Entorno
APP_ENV=development
APP_NAME=SmartInventory-Chatbot
DEBUG=true
LOG_LEVEL=INFO

# Servidor
HOST=0.0.0.0
PORT=8000

# Conexión con la API .NET
# Local: http://localhost:5299/api
DOTNET_API_BASE_URL=http://localhost:5299/api
DOTNET_API_TIMEOUT=30
DOTNET_SERVICE_API_KEY=
DOTNET_MAX_RETRIES=3
DOTNET_RETRY_BACKOFF_SECONDS=0.5

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Sesión
SESSION_STORE=memory
SESSION_TTL_SECONDS=3600
SESSION_CLEANUP_INTERVAL_SECONDS=300

# Grafo
GRAPH_TIMEOUT_SECONDS=60

# CORS (uno o más orígenes separados por coma)
ALLOWED_ORIGINS=http://localhost:5299,http://localhost:5173

# --- Opcional: trazabilidad LangSmith ---
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=smartinventory-chatbot
