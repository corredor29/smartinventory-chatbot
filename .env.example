# Entorno
APP_ENV=development
APP_NAME=SmartInventory-Chatbot
DEBUG=true
LOG_LEVEL=INFO

# Servidor
HOST=0.0.0.0
PORT=8000

# Conexión con la API .NET
DOTNET_API_BASE_URL=https://localhost:5001/api
DOTNET_API_TIMEOUT=30
DOTNET_SERVICE_API_KEY=
DOTNET_MAX_RETRIES=3
DOTNET_RETRY_BACKOFF_SECONDS=0.5

# LLM
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Sesión
SESSION_STORE=memory
SESSION_TTL_SECONDS=3600
SESSION_CLEANUP_INTERVAL_SECONDS=300

# Grafo
GRAPH_TIMEOUT_SECONDS=60

# CORS (uno o más orígenes separados por coma)
ALLOWED_ORIGINS=https://localhost:5001

# --- Opcional: trazabilidad de LangChain/LangGraph con LangSmith ---
# NOTA: estas variables las lee la librería langchain directamente de
# os.environ, no pasan por app/core/config.py. Si se usan, deben exportarse
# como variables de entorno reales del proceso (no basta con este .env),
# igual que ocurría con OPENAI_API_KEY antes del fix en agents/agent.py.
# LANGCHAIN_TRACING_V2=false
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=smartinventory-chatbot

# --- Deuda técnica documentada: no usado todavía, ver nota en ---
# --- app/session/memory_store.py sobre migrar session_store a Redis ---
# REDIS_URL=redis://localhost:6379/0
